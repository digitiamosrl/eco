{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.schema.json",
  "title": "Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test_id",
    "simulated",
    "items",
    "summary"
  ],
  "properties": {
    "test_id": {
      "type": "string"
    },
    "simulated": {
      "const": true
    },
    "summary": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stimulus_id",
          "rank",
          "mean_score",
          "score_distribution",
          "objections",
          "said_summary",
          "thought_summary",
          "responses"
        ],
        "properties": {
          "stimulus_id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "mean_score": {
            "type": "number"
          },
          "score_distribution": {
            "type": "object",
            "description": "Conteggio risposte per punteggio 1–5",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "objections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "said_summary": {
            "type": "string",
            "description": "Sintesi di cosa dicono le personas"
          },
          "thought_summary": {
            "type": "string",
            "description": "Sintesi di cosa pensano davvero, evidenziando dove diverge da said"
          },
          "responses": {
            "type": "array",
            "items": {
              "$ref": "response.schema.json"
            }
          },
          "divergent_persona_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Personas la cui risposta a questo stimolo diverge tra said e thought. Calcolato dal report (decisione PR #2)."
          }
        }
      }
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "basis"
      ],
      "description": "Calibrazione: quanto la classifica del panel rispecchia l'engagement reale dei post già pubblicati. Assente se non ancora calcolata.",
      "properties": {
        "score": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Tau-b di Kendall tra ranking del panel ed engagement reale."
        },
        "basis": {
          "type": "string",
          "description": "Su cosa è calcolato, in italiano, per esempio «12 post Digitiamo pubblicati, ott 2025–set 2026»."
        }
      }
    }
  }
}
