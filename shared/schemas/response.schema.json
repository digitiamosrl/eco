{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "response.schema.json",
  "title": "Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["persona_id", "stimulus_id", "first_reaction", "score", "objections"],
  "properties": {
    "persona_id": { "type": "string" },
    "stimulus_id": { "type": "string" },
    "first_reaction": { "type": "string" },
    "score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "objections": { "type": "array", "items": { "type": "string" } },
    "misunderstood": { "type": "array", "items": { "type": "string" } },
    "would_abandon": { "type": "boolean" },
    "quote": { "type": "string" }
  }
}
