{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prototype.schema.json",
  "title": "Prototype",
  "description": "Prototipo importato da un link Figma o da un artifact Claude, con i percorsi trovati dal punto di partenza.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "name",
    "imported_at",
    "starts"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "figma",
        "artifact"
      ]
    },
    "name": {
      "type": "string"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "starts": {
      "type": "array",
      "description": "Punti di partenza: ognuno è un percorso di schermate in ordine.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "screens"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "screens": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "name",
                "image_url"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "type": "string"
                },
                "image_url": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
